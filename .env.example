# Required runtime secrets. Copy to .env and replace all placeholder values.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opsmemory
HINDSIGHT_EXPERIMENT_BANK_ID=opsmemory-ab-experiment
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@db:5432/opsmemory
OPSMEMORY_API_KEYS=replace-key-1:alice:sre,replace-key-2:bob:viewer

# Optional runtime policy/configuration.
OPS_DEPENDENCIES_JSON={}
OPS_CRITICAL_SERVICES=
OPSMEMORY_ENABLE_DEMO_ADAPTER=false
OPSMEMORY_INGEST_SYNTHETIC=false

# Required before /incidents/{id}/verify can run. PromQL queries must each return one series.
PROMETHEUS_BASE_URL=
PROMETHEUS_TOKEN=
RECOVERY_ERROR_RATE_QUERY=
RECOVERY_P99_SECONDS_QUERY=

# Session 5: per-service independent recovery monitoring (replaces the global RECOVERY_*_QUERY for /verify).
# One entry per affected service. Queries must NOT use opsmemory_* metrics. required_labels prove series identity.
# Example shape (placeholders; point at a real exporter for that service):
# RECOVERY_BINDINGS_JSON={"payment-gateway":{"error_query":"<promql 5xx ratio>","p99_query":"<promql p99 seconds>","required_labels":{"service":"payment-gateway"}}}
RECOVERY_BINDINGS_JSON=
OPSMEMORY_RATE_LIMIT_PER_MIN=240
OPSMEMORY_AUTH_FAIL_LIMIT_PER_MIN=10

# Session 6
OPSMEMORY_USE_ADAPTER_REGISTRY=false   # true = enforce declarative adapter specs (service/environment/role/expiry). Confirm CANARY_ENVIRONMENT_SCOPE first.
CANARY_ENVIRONMENT_SCOPE=canary        # must equal the `environment` label your canary incident events were ingested with
OPSMEMORY_APPROVAL_TTL_S=3600          # default approval-request lifetime when no adapter spec sets one
